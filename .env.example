# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# Desarrollo: True · Producción: False
DJANGO_DEBUG=True
# Obligatoria en producción. Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# En producción, con https: https://midominio.ec
DJANGO_CSRF_TRUSTED_ORIGINS=

# Base de datos: si se deja vacío, se usa SQLite (db.sqlite3), sin instalar nada.
# Solo para PostgreSQL en producción: postgres://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=

# Archivos subidos (fuera de la carpeta pública del servidor web)
DJANGO_MEDIA_ROOT=
UPLOAD_MAX_MB=5

# Correo para recuperar contraseñas (en desarrollo se imprime en la consola)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-responder@midominio.ec
SITE_CONTACT_EMAIL=contacto@midominio.ec

# Opcional: caché compartida para la limitación de solicitudes con varios procesos
REDIS_URL=

# Solo para crear el primer administrador sin preguntas (borre estos valores después)
ADMIN_EMAIL=
ADMIN_PASSWORD=
